# ==============================================================================
# Book Market Intelligence Platform - Environment Configuration Template
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Backend (Groq API)
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Third-party Data Ingestion Keys
# NewsAPI: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# YouTube Data API v3 (Google Cloud Console):
YOUTUBE_API_KEY=your_youtube_api_key_here

# Security & Password Hashing
# Secret salt key for HMAC/PBKDF2 password derivation
AUTH_SECRET_SALT=enterprise_book_intel_salt_key_change_in_production
PASSWORD_MIN_LENGTH=4

# Alerting & Notifications (SMTP)
ALERT_EMAIL=alerts@bookintel.company.com
ALERT_PASSWORD=your_smtp_app_password_here
ALERT_RECEIVER=lead_analyst@company.com
ALERT_SMTP_SERVER=smtp.gmail.com
ALERT_SMTP_PORT=465

# RAG & Embeddings Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_DIR=data/vectorstore
RAG_TOP_K=5
